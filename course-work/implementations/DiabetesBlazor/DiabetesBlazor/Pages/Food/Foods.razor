@page "/foods"
@using System.Net.Http.Headers
@using System.Text.Json
@using System.Web
@using System.Text
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="foods-container">
    <div class="page-header-inline">
        <h2>🍏 База Данни с Храни</h2>
        <span class="header-divider">|</span>
        <p>Преглед и филтриране на хранителните стойности.</p>

        @if (isAdmin)
        {
            <button class="btn-sm btn-success btn-add-food" @onclick="CreateFood">➕ Добави Храна</button>
        }
    </div>

    <div class="filter-panel-compact">
        <div class="filter-grid">
            <div class="filter-item">
                <label>Име на храна</label>
                <input type="text" class="form-control-sm" placeholder="Търси..." @bind="filterName" />
            </div>

            <div class="filter-item-range">
                <label>Въглехидрати (100g)</label>
                <div class="range-inputs">
                    <input type="number" step="0.1" class="form-control-sm" placeholder="Мин" @bind="filterMinCarbs" />
                    <input type="number" step="0.1" class="form-control-sm" placeholder="Макс" @bind="filterMaxCarbs" />
                </div>
            </div>

            <div class="filter-item-range">
                <label>Калории (100g)</label>
                <div class="range-inputs">
                    <input type="number" class="form-control-sm" placeholder="Мин" @bind="filterMinCalories" />
                    <input type="number" class="form-control-sm" placeholder="Макс" @bind="filterMaxCalories" />
                </div>
            </div>

            <div class="filter-item-range">
                <label>Гликемичен индекс</label>
                <div class="range-inputs">
                    <input type="number" step="1" class="form-control-sm" placeholder="Мин" @bind="filterMinGI" />
                    <input type="number" step="1" class="form-control-sm" placeholder="Макс" @bind="filterMaxGI" />
                </div>
            </div>

            <div class="filter-item">
                <label>Сортирай по</label>
                <select class="form-select-sm" @bind="sortBy">
                    <option value="Id">Най-нови първо</option>
                    <option value="Name">Име</option>
                    <option value="CarbPer100g">Въглехидрати</option>
                    <option value="ProteinPer100g">Протеини</option>
                    <option value="FatPer100g">Мазнини</option>
                    <option value="CaloriesPer100g">Калории</option>
                    <option value="GlycemicIndex">Гликемичен Индекс</option>
                </select>
            </div>

            <div class="filter-item width-auto">
                <label>Посока / Редове</label>
                <div class="range-inputs">
                    <button class="btn-sm btn-secondary btn-direction" @onclick="ToggleSortDirection" title="@(isDescending ? "Низходящо" : "Възходящо")">
                        @(isDescending ? "▼" : "▲")
                    </button>
                    <select class="form-select-sm" style="min-width: 60px;" @onchange="OnPageSizeChanged">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                </div>
            </div>

            <div class="filter-buttons">
                <button class="btn-sm btn-secondary" @onclick="ResetFilters" title="Изчисти филтри">🧹</button>
                <button class="btn-sm btn-primary" @onclick="ApplyFilters">Търси</button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-status">
            <div class="spinner"></div>
            <span>Зареждане на храните...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(apiError))
    {
        <div class="alert alert-danger">@apiError</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="foods-table">
                <thead>
                    <tr>
                        <th>Име</th>
                        <th class="text-center">Въглехидрати (100g)</th>
                        <th class="text-center">Протеини (100g)</th>
                        <th class="text-center">Мазнини (100g)</th>
                        <th class="text-center">Калории (100g)</th>
                        <th class="text-center">Гликемичен Индекс</th>
                        @if (isAdmin)
                        {
                            <th class="text-center">Действия</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (foodsList.HasValue && foodsList.Value.GetArrayLength() > 0)
                    {
                        @foreach (var food in foodsList.Value.EnumerateArray())
                        {
                            var foodId = food.TryGetProperty("id", out var idProp) ? idProp.GetInt32() : 0;
                            <tr>
                                <td class="food-name">@GetSafeString(food, "name", "Неизвестно")</td>
                                <td class="text-center weight-bold text-carbs">@GetSafeDouble(food, "carbPer100g").ToString("F1") g</td>
                                <td class="text-center">@GetSafeDouble(food, "proteinPer100g").ToString("F1") g</td>
                                <td class="text-center">@GetSafeDouble(food, "fatPer100g").ToString("F1") g</td>
                                <td class="text-center text-calories">@GetSafeDouble(food, "caloriesPer100g").ToString("F0") kcal</td>
                                <td class="text-center">
                                    <span class="gi-badge @GetGiClass(GetSafeDouble(food, "glycemicIndex"))">
                                        @GetSafeDouble(food, "glycemicIndex").ToString("F0")
                                    </span>
                                </td>
                                @if (isAdmin)
                                {
                                    <td class="text-center">
                                        <div class="admin-actions">
                                            <button class="btn-action edit" @onclick="() => EditFood(foodId)" title="Редактирай">✏️</button>
                                            <button class="btn-action delete" @onclick="() => DeleteFoodAsync(foodId)" title="Изтрий">🗑️</button>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(isAdmin ? 7 : 6)" class="text-empty">Няма намерени храни.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-footer">
            <div class="pagination-info">
                Показани @(foodsList?.GetArrayLength() ?? 0) от общо @totalCount записи
            </div>
            <div class="pagination-buttons">
                <span class="page-indicator">Страница <strong>@currentPage</strong> от <strong>@totalPages</strong></span>
                <button class="btn-page" disabled="@(!hasPreviousPage)" @onclick="GoToPreviousPage">◀ Предишна</button>
                <button class="btn-page" disabled="@(!hasNextPage)" @onclick="GoToNextPage">Следваща ▶</button>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool isAdmin = false;
    private string apiError = string.Empty;

    private JsonElement? foodsList = null;
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalCount = 0;
    private int totalPages = 1;
    private bool hasPreviousPage = false;
    private bool hasNextPage = false;

    private string filterName = string.Empty;
    private double? filterMinCarbs;
    private double? filterMaxCarbs;
    private double? filterMinCalories;
    private double? filterMaxCalories;
    private double? filterMinGI;
    private double? filterMaxGI;

    private string sortBy = "Id";
    private bool isDescending = true; 

    protected override async Task OnInitializedAsync()
    {
        await CheckUserRoleAsync();
        await LoadFoodsAsync();
    }

    private async Task CheckUserRoleAsync()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (!string.IsNullOrEmpty(token))
            {
                isAdmin = CheckIfAdminFromToken(token);
            }
        }
        catch { isAdmin = false; }
    }

    private bool CheckIfAdminFromToken(string token)
    {
        try
        {
            var parts = token.Split('.');
            if (parts.Length < 2) return false;

            var payload = parts[1];
            payload = payload.PadRight(payload.Length + (4 - payload.Length % 4) % 4, '=');
            var jsonBytes = Convert.FromBase64String(payload);

            using var doc = JsonDocument.Parse(jsonBytes);
            var root = doc.RootElement;

            string[] roleClaims = { "role", "Roles", "http://schemas.microsoft.com/ws/2008/06/identity/claims/role" };

            foreach (var claim in roleClaims)
            {
                if (root.TryGetProperty(claim, out var roleProp))
                {
                    if (roleProp.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var r in roleProp.EnumerateArray())
                        {
                            if (r.GetString() == "Admin") return true;
                        }
                    }
                    else if (roleProp.ValueKind == JsonValueKind.String)
                    {
                        if (roleProp.GetString() == "Admin") return true;
                    }
                }
            }
        }
        catch { }
        return false;
    }

    private async Task LoadFoodsAsync()
    {
        isLoading = true;
        apiError = string.Empty;

        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (string.IsNullOrEmpty(token))
            {
                Navigation.NavigateTo("/");
                return;
            }

            var query = HttpUtility.ParseQueryString(string.Empty);
            query["PageNumber"] = currentPage.ToString();
            query["PageSize"] = pageSize.ToString();

            query["SortBy"] = sortBy;
            query["IsDescending"] = isDescending.ToString().ToLower();

            if (!string.IsNullOrWhiteSpace(filterName)) query["Filters.Name"] = filterName;
            if (filterMinCarbs.HasValue) query["Filters.MinCarbs"] = filterMinCarbs.Value.ToString();
            if (filterMaxCarbs.HasValue) query["Filters.MaxCarbs"] = filterMaxCarbs.Value.ToString();
            if (filterMinCalories.HasValue) query["Filters.MinCalories"] = filterMinCalories.Value.ToString();
            if (filterMaxCalories.HasValue) query["Filters.MaxCalories"] = filterMaxCalories.Value.ToString();
            if (filterMinGI.HasValue) query["Filters.MinGlycemicIndex"] = filterMinGI.Value.ToString();
            if (filterMaxGI.HasValue) query["Filters.MaxGlycemicIndex"] = filterMaxGI.Value.ToString();

            var url = $"api/Foods?{query.ToString()}";

            var request = new HttpRequestMessage(HttpMethod.Get, url);
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(jsonString);
                var root = doc.RootElement;

                if (root.TryGetProperty("totalCount", out var tc) || root.TryGetProperty("TotalCount", out tc)) totalCount = tc.GetInt32();
                if (root.TryGetProperty("totalPages", out var tp) || root.TryGetProperty("TotalPages", out tp)) totalPages = tp.GetInt32();
                if (root.TryGetProperty("hasPreviousPage", out var hp) || root.TryGetProperty("HasPreviousPage", out hp)) hasPreviousPage = hp.GetBoolean();
                if (root.TryGetProperty("hasNextPage", out var hn) || root.TryGetProperty("HasNextPage", out hn)) hasNextPage = hn.GetBoolean();

                if (root.TryGetProperty("items", out var itemsProp) || root.TryGetProperty("Items", out itemsProp))
                {
                    foodsList = itemsProp.Clone();
                }
            }
            else
            {
                apiError = $"Грешка при зареждане на храните (Код: {response.StatusCode})";
            }
        }
        catch (Exception ex)
        {
            apiError = $"Възникна системна грешка: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleSortDirection()
    {
        isDescending = !isDescending;
        await LoadFoodsAsync();
    }

    private void CreateFood()
    {
        Navigation.NavigateTo("/foods/create");
    }

    private void EditFood(int id)
    {
        Navigation.NavigateTo($"/foods/edit/{id}");
    }

    private async Task DeleteFoodAsync(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Сигурни ли сте, че искате да изтриете тази храна?");
        if (!confirmed) return;

        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            var request = new HttpRequestMessage(HttpMethod.Delete, $"api/Foods/{id}");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                await LoadFoodsAsync();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Възникна грешка при изтриването. Бекендът отказа операцията.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Грешка: {ex.Message}");
        }
    }

    private async Task ApplyFilters() { currentPage = 1; await LoadFoodsAsync(); }

    private async Task ResetFilters()
    {
        filterName = string.Empty;
        filterMinCarbs = null;
        filterMaxCarbs = null;
        filterMinCalories = null;
        filterMaxCalories = null;
        filterMinGI = null;
        filterMaxGI = null;
        sortBy = "Id";
        isDescending = true;
        currentPage = 1;
        await LoadFoodsAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var newSize)) { pageSize = newSize; currentPage = 1; await LoadFoodsAsync(); } }
    private async Task GoToPreviousPage() { if (hasPreviousPage) { currentPage--; await LoadFoodsAsync(); } }
    private async Task GoToNextPage() { if (hasNextPage) { currentPage++; await LoadFoodsAsync(); } }

    private string GetSafeString(JsonElement element, string propName, string fallback)
    {
        var camel = char.ToLower(propName[0]) + propName.Substring(1);
        var pascal = char.ToUpper(propName[0]) + propName.Substring(1);
        if (element.TryGetProperty(camel, out var p) || element.TryGetProperty(pascal, out p)) return p.GetString() ?? fallback;
        return fallback;
    }

    private double GetSafeDouble(JsonElement element, string propName)
    {
        var camel = char.ToLower(propName[0]) + propName.Substring(1);
        var pascal = char.ToUpper(propName[0]) + propName.Substring(1);
        if (element.TryGetProperty(camel, out var p) || element.TryGetProperty(pascal, out p))
        {
            if (p.ValueKind == JsonValueKind.Number) return p.GetDouble();
            if (p.ValueKind == JsonValueKind.String && double.TryParse(p.GetString(), out var parsed)) return parsed;
        }
        return 0;
    }

    private string GetGiClass(double gi)
    {
        if (gi <= 55) return "gi-low";
        if (gi <= 69) return "gi-medium";
        return "gi-high";
    }
}

