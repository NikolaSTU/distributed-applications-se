@page "/foods/edit/{Id:int}"
@using System.Net.Http.Headers
@using System.Text.Json
@using System.Text
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="form-page-container">
    <div class="form-header">
        <button class="btn-back" @onclick="GoBack">◀ Назад</button>
        <h2>✏️ Редактиране на Храна</h2>
        <p>Промени макронутриентите. Сървърът ще преизчисли калориите автоматично.</p>
    </div>

    @if (isLoading)
    {
        <div class="loading-status">Зареждане на данните за храната...</div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="form-card">
            <div class="form-group">
                <label>Наименование на храната*</label>
                <input type="text" class="form-control" @bind="foodName" />
            </div>

            <div class="form-grid-3">
                <div class="form-group">
                    <label>Въглехидрати (0-100g)*</label>
                    <input type="number" step="0.1" class="form-control" @bind="carbPer100g" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label>Протеини (0-100g)*</label>
                    <input type="number" step="0.1" class="form-control" @bind="proteinPer100g" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label>Мазнини (0-100g)*</label>
                    <input type="number" step="0.1" class="form-control" @bind="fatPer100g" @bind:event="oninput" />
                </div>
            </div>

            <div class="form-group">
                <label>Гликемичен индекс (0-100)</label>
                <input type="number" step="1" class="form-control" @bind="glycemicIndex" />
            </div>

            <div class="macro-summary-bar @(TotalMacros > 100 ? "over-limit" : "")">
                Общ сбор на макросите: <strong>@TotalMacros.ToString("F1") g</strong> / 100 g
            </div>

            <div class="form-actions">
                <button class="btn btn-save" @onclick="UpdateFoodAsync" disabled="@(isSaving || TotalMacros > 100)">
                    @if (isSaving)
                    {
                        <span>Запазване...</span>
                    }
                    else
                    {

                        <span>💾 Обнови Данните</span>
                    }
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private string foodName = string.Empty;
    private double carbPer100g;
    private double proteinPer100g;
    private double fatPer100g;
    private double glycemicIndex;

    private bool isLoading = true;
    private bool isSaving = false;
    private string errorMessage = string.Empty;

    private double TotalMacros => carbPer100g + proteinPer100g + fatPer100g;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            var request = new HttpRequestMessage(HttpMethod.Get, $"api/Foods/{Id}");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(jsonString);
                var root = doc.RootElement;

                foodName = GetPropString(root, "name");
                carbPer100g = GetPropDouble(root, "carbPer100g");
                proteinPer100g = GetPropDouble(root, "proteinPer100g");
                fatPer100g = GetPropDouble(root, "fatPer100g");
                glycemicIndex = GetPropDouble(root, "glycemicIndex");
            }
            else
            {
                errorMessage = "Неуспешно зареждане на данните за храната.";
            }
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { isLoading = false; }
    }

    private async Task UpdateFoodAsync()
    {
        if (string.IsNullOrWhiteSpace(foodName) || foodName.Length < 2)
        {
            errorMessage = "Името на храната трябва да съдържа поне 2 символа.";
            return;
        }

        if (TotalMacros > 100)
        {
            errorMessage = "Общият сбор на макросите не може да надвишава 100 грама.";
            return;
        }

        isSaving = true;
        errorMessage = string.Empty;

        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");

            var updatedFood = new
            {
                id = Id,
                name = foodName,
                carbPer100g = carbPer100g,
                proteinPer100g = proteinPer100g,
                fatPer100g = fatPer100g,
                glycemicIndex = glycemicIndex
            };

            var request = new HttpRequestMessage(HttpMethod.Put, $"api/Foods/{Id}");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            request.Content = new StringContent(JsonSerializer.Serialize(updatedFood), Encoding.UTF8, "application/json");

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/foods");
            }
            else
            {
                errorMessage = "Проблем при обновяването на данните в сървъра.";
            }
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { isSaving = false; }
    }

    private void GoBack() => Navigation.NavigateTo("/foods");
    private string GetPropString(JsonElement el, string name) => el.TryGetProperty(name, out var p) ? p.GetString() ?? "" : "";
    private double GetPropDouble(JsonElement el, string name)
    {
        var camel = char.ToLower(name[0]) + name.Substring(1);
        var pascal = char.ToUpper(name[0]) + name.Substring(1);
        if (el.TryGetProperty(camel, out var p) || el.TryGetProperty(pascal, out p))
        {
            if (p.ValueKind == JsonValueKind.Number) return p.GetDouble();
            if (p.ValueKind == JsonValueKind.String && double.TryParse(p.GetString(), out var d)) return d;
        }
        return 0;
    }
}