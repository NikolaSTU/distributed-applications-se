@page "/logbook"
@using System.Net.Http.Headers
@using System.Text.Json
@using System.Web
@using System.Text
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="logbook-container">
    <div class="page-header-inline">
        <h2>📊 Дневник</h2>
        <span class="header-divider">|</span>
        <p>Преглед и управление на вашите записи за кръвна захар и инсулин.</p>
    </div>

    <div class="tabs-header">
        <button class="tab-button @(activeTab == "glucose" ? "active" : "")" @onclick="SwitchTabGlucose">
            🩸 Кръвна Захар
        </button>
        <button class="tab-button @(activeTab == "insulin" ? "active" : "")" @onclick="SwitchTabInsulin">
            💉 Инсулин
        </button>
    </div>

    <div class="filter-panel-compact">
        <div class="filter-grid-two-rows">
            @if (activeTab == "glucose")
            {
                <div class="filter-row">
                    <div class="filter-item flex-2">
                        <label>Бележка</label>
                        <input type="text" class="form-control-sm" placeholder="Търси в бележки..." @bind="filterGlucoseNote" />
                    </div>

                    <div class="filter-item flex-1">
                        <label>Източник</label>
                        <input type="text" class="form-control-sm" placeholder="Апарат, Сензор..." @bind="filterGlucoseSource" />
                    </div>

                    <div class="filter-item-range flex-1">
                        <label>Стойност (mg/dL)</label>
                        <div class="range-inputs">
                            <input type="number" class="form-control-sm" placeholder="Мин" @bind="filterGlucoseMinValue" />
                            <input type="number" class="form-control-sm" placeholder="Макс" @bind="filterGlucoseMaxValue" />
                        </div>
                    </div>
                </div>

                <div class="filter-row row-bottom">
                    <div class="filter-item">
                        <label>След (Дата)</label>
                        <input type="date" class="form-control-sm" @bind="filterGlucoseFromDate" />
                    </div>

                    <div class="filter-item">
                        <label>Преди (Дата)</label>
                        <input type="date" class="form-control-sm" @bind="filterGlucoseToDate" />
                    </div>

                    <div class="filter-item width-auto">
                        <label>Сортирай по</label>
                        <select class="form-select-sm" @bind="sortByGlucose">
                            <option value="Id">Най-нови първо (Id)</option>
                            <option value="MeasuredAt">Дата/Час</option>
                            <option value="Value">Стойност</option>
                            <option value="Source">Източник</option>
                        </select>
                    </div>

                    <div class="filter-item width-auto">
                        <label>Посока / Редове</label>
                        <div class="range-inputs">
                            <button class="btn-sm btn-secondary btn-direction" @onclick="ToggleSortDirectionGlucose" title="@(isDescendingGlucose ? "Низходящо" : "Възходящо")">
                                @(isDescendingGlucose ? "▼" : "▲")
                            </button>
                            <select class="form-select-sm" @onchange="OnPageSizeChanged">
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="20">20</option>
                                <option value="50">50</option>
                            </select>
                        </div>
                    </div>

                    <div class="filter-buttons">
                        <button class="btn-sm btn-secondary" @onclick="ResetFilters" title="Изчисти филтри">🧹 Изчисти</button>
                        <button class="btn-sm btn-primary" @onclick="ApplyFilters">Търси</button>
                        <button class="btn-sm btn-success btn-add-entry" @onclick="CreateEntry">➕ Добави запис</button>
                    </div>
                </div>
            }
            else
            {
                <div class="filter-row">
                    <div class="filter-item flex-2">
                        <label>Тип инсулин</label>
                        <input type="text" class="form-control-sm" placeholder="Бърз, Базален, Марка..." @bind="filterInsulinType" />
                    </div>

                    <div class="filter-item-range flex-1">
                        <label>Единици (U)</label>
                        <div class="range-inputs">
                            <input type="number" step="0.1" class="form-control-sm" placeholder="Мин" @bind="filterInsulinMinUnits" />
                            <input type="number" step="0.1" class="form-control-sm" placeholder="Макс" @bind="filterInsulinMaxUnits" />
                        </div>
                    </div>
                </div>

                <div class="filter-row row-bottom">
                    <div class="filter-item">
                        <label>След (Дата)</label>
                        <input type="date" class="form-control-sm" @bind="filterInsulinFromDate" />
                    </div>

                    <div class="filter-item">
                        <label>Преди (Дата)</label>
                        <input type="date" class="form-control-sm" @bind="filterInsulinToDate" />
                    </div>

                    <div class="filter-item width-auto">
                        <label>Сортирай по</label>
                        <select class="form-select-sm" @bind="sortByInsulin">
                            <option value="Id">Най-нови първо (Id)</option>
                            <option value="InjectedAt">Дата/Час</option>
                            <option value="Units">Единици</option>
                            <option value="Type">Тип</option>
                        </select>
                    </div>

                    <div class="filter-item width-auto">
                        <label>Посока / Редове</label>
                        <div class="range-inputs">
                            <button class="btn-sm btn-secondary btn-direction" @onclick="ToggleSortDirectionInsulin" title="@(isDescendingInsulin ? "Низходящо" : "Възходящо")">
                                @(isDescendingInsulin ? "▼" : "▲")
                            </button>
                            <select class="form-select-sm" @onchange="OnPageSizeChanged">
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="20">20</option>
                                <option value="50">50</option>
                            </select>
                        </div>
                    </div>

                    <div class="filter-buttons">
                        <button class="btn-sm btn-secondary" @onclick="ResetFilters" title="Изчисти филтри">🧹 Изчисти</button>
                        <button class="btn-sm btn-primary" @onclick="ApplyFilters">Търси</button>
                        <button class="btn-sm btn-success btn-add-entry" @onclick="CreateEntry">➕ Добави запис</button>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-status">
            <div class="spinner"></div>
            <span>@(activeTab == "glucose" ? "Зареждане на записи за кръвна захар..." : "Зареждане на записи за инсулин...")</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(apiError))
    {
        <div class="alert alert-danger">@apiError</div>
    }
    else if (activeTab == "glucose")
    {
        <div class="table-responsive">
            <table class="logbook-table">
                <thead>
                    <tr>
                        <th>Дата/Час</th>
                        <th class="text-center">Стойност (mg/dL)</th>
                        <th class="text-center">Източник</th>
                        @if (isAdmin)
                        {
                            <th class="text-center">Потребител</th>
                        }
                        <th>Бележка</th>
                        <th class="text-center">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @if (glucoseList.HasValue && glucoseList.Value.GetArrayLength() > 0)
                    {
                        @foreach (var entry in glucoseList.Value.EnumerateArray())
                        {
                            var entryId = entry.TryGetProperty("id", out var idProp) ? idProp.GetInt32() : 0;
                            var measuredAt = GetSafeDateTime(entry, "measuredAt");
                            var value = GetSafeDouble(entry, "value");
                            var glucoseClass = GetGlucoseClass(value);
                            var noteText = GetSafeString(entry, "note", "-");
                            var userId = entry.TryGetProperty("userId", out var uProp) ? uProp.GetInt32() : 0;

                            <tr>
                                <td class="entry-date">@measuredAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-center weight-bold">
                                    <span class="glucose-badge @glucoseClass">@value.ToString("F0") mg/dL</span>
                                </td>
                                <td class="text-center">@GetSafeString(entry, "source", "-")</td>
                                @if (isAdmin)
                                {
                                    <td class="text-center">
                                        <span class="badge-user">@GetUserDisplayName(userId)</span>
                                    </td>
                                }
                                <td class="entry-note-cell">
                                    <div class="truncate-note-wrapper" title="@noteText">
                                        @noteText
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="entry-actions">
                                        <button class="btn-action edit" @onclick="@(() => EditEntryHandler(entryId, "glucose"))" title="Редактирай">✏️</button>
                                        <button class="btn-action delete" @onclick="@(() => DeleteEntryHandler(entryId, "GlucoseEntries"))" title="Изтрий">🗑️</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(isAdmin ? 6 : 5)" class="text-empty">Няма намерени записи.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (activeTab == "insulin")
    {
        <div class="table-responsive">
            <table class="logbook-table">
                <thead>
                    <tr>
                        <th>Дата/Час</th>
                        <th class="text-center">Единици</th>
                        <th class="text-center">Тип</th>
                        @if (isAdmin)
                        {
                            <th class="text-center">Потребител</th>
                        }
                        <th>Бележка</th>
                        <th class="text-center">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @if (insulinList.HasValue && insulinList.Value.GetArrayLength() > 0)
                    {
                        @foreach (var entry in insulinList.Value.EnumerateArray())
                        {
                            var entryId = entry.TryGetProperty("id", out var idProp) ? idProp.GetInt32() : 0;
                            var injectedAt = GetSafeDateTime(entry, "injectedAt");
                            var units = GetSafeDouble(entry, "units");
                            var noteText = GetSafeString(entry, "note", "-");
                            var userId = entry.TryGetProperty("userId", out var uProp) ? uProp.GetInt32() : 0;

                            <tr>
                                <td class="entry-date">@injectedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-center weight-bold text-insulin">@units.ToString("F1") U</td>
                                <td class="text-center">@GetSafeString(entry, "type", "-")</td>
                                @if (isAdmin)
                                {
                                    <td class="text-center">
                                        <span class="badge-user">@GetUserDisplayName(userId)</span>
                                    </td>
                                }
                                <td class="entry-note-cell">
                                    <div class="truncate-note-wrapper" title="@noteText">
                                        @noteText
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="entry-actions">
                                        <button class="btn-action edit" @onclick="@(() => EditEntryHandler(entryId, "insulin"))" title="Редактирай">✏️</button>
                                        <button class="btn-action delete" @onclick="@(() => DeleteEntryHandler(entryId, "InsulinEntries"))" title="Изтрий">🗑️</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(isAdmin ? 6 : 5)" class="text-empty">Няма намерени записи.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (!isLoading && string.IsNullOrEmpty(apiError))
    {
        <div class="pagination-footer">
            <div class="pagination-info">
                Показани @((activeTab == "glucose" ? glucoseList?.GetArrayLength() : insulinList?.GetArrayLength()) ?? 0) от общо @totalCount записи
            </div>
            <div class="pagination-buttons">
                <span class="page-indicator">Страница <strong>@currentPage</strong> от <strong>@totalPages</strong></span>
                <button class="btn-page" disabled="@(!hasPreviousPage)" @onclick="GoToPreviousPage">◀ Предишна</button>
                <button class="btn-page" disabled="@(!hasNextPage)" @onclick="GoToNextPage">Следваща ▶</button>
            </div>
        </div>
    }
</div>

@code {
    private string activeTab = "glucose";
    private bool isLoading = true;
    private string apiError = string.Empty;
    private bool isAdmin = false;

    private Dictionary<int, string> userCache = new Dictionary<int, string>();

    private string filterGlucoseNote = string.Empty;
    private string filterGlucoseSource = string.Empty;
    private double? filterGlucoseMinValue;
    private double? filterGlucoseMaxValue;
    private DateTime? filterGlucoseFromDate;
    private DateTime? filterGlucoseToDate;

    private string sortByGlucose = "MeasuredAt";
    private bool isDescendingGlucose = true;

    private string filterInsulinType = string.Empty;
    private double? filterInsulinMinUnits;
    private double? filterInsulinMaxUnits;
    private DateTime? filterInsulinFromDate;
    private DateTime? filterInsulinToDate;

    private string sortByInsulin = "InjectedAt";
    private bool isDescendingInsulin = true;

    private int currentPage = 1;
    private int pageSize = 10;
    private int totalCount = 0;
    private int totalPages = 1;
    private bool hasPreviousPage = false;
    private bool hasNextPage = false;

    private JsonElement? glucoseList = null;
    private JsonElement? insulinList = null;

    protected override async Task OnInitializedAsync()
    {
        await CheckUserRoleAsync();
        await LoadEntriesAsync();
    }

    private async Task LoadEntriesAsync()
    {
        isLoading = true;
        apiError = string.Empty;

        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            var queryParams = HttpUtility.ParseQueryString(string.Empty);
            queryParams["PageNumber"] = currentPage.ToString();
            queryParams["PageSize"] = pageSize.ToString();

            string endpoint = "";

            if (activeTab == "glucose")
            {
                endpoint = "api/GlucoseEntries"; 
                if (!string.IsNullOrEmpty(filterGlucoseNote)) queryParams["Filters.Note"] = filterGlucoseNote;
                if (!string.IsNullOrEmpty(filterGlucoseSource)) queryParams["Filters.Source"] = filterGlucoseSource;
                if (filterGlucoseMinValue.HasValue) queryParams["Filters.MinValue"] = filterGlucoseMinValue.Value.ToString();
                if (filterGlucoseMaxValue.HasValue) queryParams["Filters.MaxValue"] = filterGlucoseMaxValue.Value.ToString();
                if (filterGlucoseFromDate.HasValue) queryParams["Filters.FromDate"] = filterGlucoseFromDate.Value.ToString("yyyy-MM-ddTHH:mm:ss");
                if (filterGlucoseToDate.HasValue) queryParams["Filters.ToDate"] = filterGlucoseToDate.Value.ToString("yyyy-MM-ddTHH:mm:ss");

                if (!string.IsNullOrEmpty(sortByGlucose)) queryParams["SortBy"] = sortByGlucose;
                queryParams["IsDescending"] = isDescendingGlucose.ToString().ToLower();
            }
            else
            {
                endpoint = "api/InsulinEntries"; 
                if (!string.IsNullOrEmpty(filterInsulinType)) queryParams["Filters.Type"] = filterInsulinType;
                if (filterInsulinMinUnits.HasValue) queryParams["Filters.MinUnits"] = filterInsulinMinUnits.Value.ToString();
                if (filterInsulinMaxUnits.HasValue) queryParams["Filters.MaxUnits"] = filterInsulinMaxUnits.Value.ToString();
                if (filterInsulinFromDate.HasValue) queryParams["Filters.FromDate"] = filterInsulinFromDate.Value.ToString("yyyy-MM-ddTHH:mm:ss");
                if (filterInsulinToDate.HasValue) queryParams["Filters.ToDate"] = filterInsulinToDate.Value.ToString("yyyy-MM-ddTHH:mm:ss");

                if (!string.IsNullOrEmpty(sortByInsulin)) queryParams["SortBy"] = sortByInsulin;
                queryParams["IsDescending"] = isDescendingInsulin.ToString().ToLower();
            }

            var url = $"{endpoint}?{queryParams}";
            var request = new HttpRequestMessage(HttpMethod.Get, url);

            if (!string.IsNullOrEmpty(token))
            {
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var jsonStr = await response.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(jsonStr);
                var root = doc.RootElement;

                if (root.TryGetProperty("items", out var itemsProp))
                {
                    if (activeTab == "glucose")
                    {
                        glucoseList = itemsProp.Clone();
                        await LoadUsernamesAsync(glucoseList);
                    }
                    else
                    {
                        insulinList = itemsProp.Clone();
                        await LoadUsernamesAsync(insulinList);
                    }
                }

                totalCount = root.TryGetProperty("totalCount", out var tc) ? tc.GetInt32() : 0;
                totalPages = root.TryGetProperty("totalPages", out var tp) ? tp.GetInt32() : 1;
                hasPreviousPage = root.TryGetProperty("hasPreviousPage", out var hp) && hp.GetBoolean();
                hasNextPage = root.TryGetProperty("hasNextPage", out var hn) && hn.GetBoolean();
            }
            else
            {
                apiError = $"Грешка при зареждане на данните: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            apiError = $"Възникна неочаквана грешка: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadUsernamesAsync(JsonElement? list)
    {
        if (!list.HasValue || !isAdmin) return;

        var uniqueUserIds = new HashSet<int>();
        foreach (var entry in list.Value.EnumerateArray())
        {
            if (entry.TryGetProperty("userId", out var uProp) && uProp.ValueKind == JsonValueKind.Number)
            {
                int uid = uProp.GetInt32();
                if (uid > 0 && !userCache.ContainsKey(uid))
                {
                    uniqueUserIds.Add(uid);
                }
            }
        }

        if (uniqueUserIds.Count == 0) return;

        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");

        foreach (var userId in uniqueUserIds)
        {
            try
            {
                var request = new HttpRequestMessage(HttpMethod.Get, $"api/Users/{userId}");
                if (!string.IsNullOrEmpty(token))
                {
                    request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
                }

                var response = await Http.SendAsync(request);
                if (response.IsSuccessStatusCode)
                {
                    var jsonStr = await response.Content.ReadAsStringAsync();
                    using var doc = JsonDocument.Parse(jsonStr);
                    var root = doc.RootElement;

                    if (root.TryGetProperty("username", out var nameProp))
                    {
                        userCache[userId] = nameProp.GetString() ?? $"ID: {userId}";
                    }
                    else
                    {
                        userCache[userId] = $"ID: {userId}";
                    }
                }
                else
                {
                    userCache[userId] = $"ID: {userId}";
                }
            }
            catch
            {
                userCache[userId] = $"ID: {userId}";
            }
        }
    }

    private string GetUserDisplayName(int userId)
    {
        if (userId <= 0) return "-";
        return userCache.ContainsKey(userId) ? userCache[userId] : $"Зареждане ({userId})...";
    }

    private async Task CheckUserRoleAsync()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (!string.IsNullOrEmpty(token))
            {
                var chunks = token.Split('.');
                if (chunks.Length > 1)
                {
                    var base64 = chunks[1].Replace('-', '+').Replace('_', '/');
                    switch (base64.Length % 4)
                    {
                        case 2: base64 += "=="; break;
                        case 3: base64 += "="; break;
                    }
                    var jsonBytes = Convert.FromBase64String(base64);
                    using var doc = JsonDocument.Parse(jsonBytes);
                    var root = doc.RootElement;

                    if (root.TryGetProperty("role", out var roleProp))
                    {
                        isAdmin = roleProp.GetString() == "Admin";
                    }
                    else if (root.TryGetProperty("http://schemas.microsoft.com/ws/2008/06/identity/claims/role", out var longRoleProp))
                    {
                        isAdmin = longRoleProp.GetString() == "Admin";
                    }
                }
            }
        }
        catch
        {
            isAdmin = false;
        }
    }

    private async Task SwitchTabGlucose()
    {
        if (activeTab == "glucose") return;
        activeTab = "glucose";
        currentPage = 1;
        await LoadEntriesAsync();
    }

    private async Task SwitchTabInsulin()
    {
        if (activeTab == "insulin") return;
        activeTab = "insulin";
        currentPage = 1;
        await LoadEntriesAsync();
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadEntriesAsync();
    }

    private async Task ResetFilters()
    {
        if (activeTab == "glucose")
        {
            filterGlucoseNote = string.Empty;
            filterGlucoseSource = string.Empty;
            filterGlucoseMinValue = null;
            filterGlucoseMaxValue = null;
            filterGlucoseFromDate = null;
            filterGlucoseToDate = null;
            sortByGlucose = "MeasuredAt";
            isDescendingGlucose = true;
        }
        else
        {
            filterInsulinType = string.Empty;
            filterInsulinMinUnits = null;
            filterInsulinMaxUnits = null;
            filterInsulinFromDate = null;
            filterInsulinToDate = null;
            sortByInsulin = "InjectedAt";
            isDescendingInsulin = true;
        }
        currentPage = 1;
        await LoadEntriesAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newSize))
        {
            pageSize = newSize;
            currentPage = 1;
            await LoadEntriesAsync();
        }
    }

    private async Task GoToPreviousPage()
    {
        if (hasPreviousPage)
        {
            currentPage--;
            await LoadEntriesAsync();
        }
    }

    private async Task GoToNextPage()
    {
        if (hasNextPage)
        {
            currentPage++;
            await LoadEntriesAsync();
        }
    }

    private void CreateEntry() => Navigation.NavigateTo(activeTab == "glucose" ? "/logbook/create/glucose" : "/logbook/create/insulin");
    private void EditEntryHandler(int id, string type) => Navigation.NavigateTo($"/logbook/edit/{type}/{id}");

    private async Task DeleteEntryHandler(int id, string type)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Сигурни ли сте, че искате да изтриете този запис?");
        if (!confirmed) return;

        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            var request = new HttpRequestMessage(HttpMethod.Delete, $"api/{type}/{id}");
            if (!string.IsNullOrEmpty(token))
            {
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                await LoadEntriesAsync();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Възникна грешка при триене на записа.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Грешка: {ex.Message}");
        }
    }

    private string GetGlucoseClass(double value)
    {
        if (value < 70) return "glucose-low";
        if (value > 180) return "glucose-high";
        return "glucose-normal";
    }

    private string GetSafeString(JsonElement element, string propName, string fallback) =>
        element.TryGetProperty(propName, out var p) && p.ValueKind == JsonValueKind.String ? p.GetString() ?? fallback : fallback;

    private double GetSafeDouble(JsonElement element, string propName) =>
        element.TryGetProperty(propName, out var p) && p.ValueKind == JsonValueKind.Number ? p.GetDouble() : 0.0;

    private DateTime GetSafeDateTime(JsonElement element, string propName) =>
        element.TryGetProperty(propName, out var p) && p.ValueKind == JsonValueKind.String && DateTime.TryParse(p.GetString(), out var dt) ? dt : DateTime.Now;

    private async Task ToggleSortDirectionGlucose()
    {
        isDescendingGlucose = !isDescendingGlucose;
        await LoadEntriesAsync();
    }

    private async Task ToggleSortDirectionInsulin()
    {
        isDescendingInsulin = !isDescendingInsulin;
        await LoadEntriesAsync();
    }
}

<style>
    .logbook-container {
        max-width: 1250px;
        margin: 0 auto;
        font-family: 'Segoe UI', system-ui, sans-serif;
        padding: 5px;
    }

    .page-header-inline {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
        padding-bottom: 5px;
        border-bottom: 1px solid #eef2f5;
    }

        .page-header-inline h2 {
            margin: 0;
