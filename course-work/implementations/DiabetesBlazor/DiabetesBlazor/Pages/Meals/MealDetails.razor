@page "/meals/details/{MealId:int}"
@using System.Net.Http.Headers
@using System.Text.Json
@using System.Text
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="meals-container">
    <div class="page-header-inline">
        <h2>📋 Детайли за храненето: @mealName</h2>
        <span class="header-divider">|</span>
        <p>Дата: @mealDate.ToString("dd.MM.yyyy HH:mm")</p>
        <button class="btn-add-food" style="background: #3b82f6;" @onclick="BackToMeals">◀ Назад към дневника</button>
    </div>

    @if (isLoadingPage)
    {
        <div class="loading-status">
            <div class="spinner"></div>
            <span>Зареждане на детайлите...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(pageErrorMessage))
    {
        <div class="alert">@pageErrorMessage</div>
    }
    else
    {
        <div class="details-split-grid">

            <div class="details-card-panel">
                <h3>➕ Добави храна към менюто</h3>
                <hr class="panel-divider" />

                @if (!string.IsNullOrEmpty(formErrorMessage))
                {
                    <div class="alert" style="margin-bottom: 12px; padding: 8px; font-size: 12px;">@formErrorMessage</div>
                }

                <div class="filter-item" style="margin-bottom: 12px;">
                    <label>Изберете продукт от базата*</label>
                    <select class="form-control-sm" @bind="selectedFoodId">
                        <option value="0">-- Изберете храна --</option>
                        @foreach (var food in allAvailableFoods)
                        {
                            <option value="@food.Id">@food.Name (@food.CaloriesPer100g.ToString("F0") kcal / 100г)</option>
                        }
                    </select>
                </div>

                <div class="filter-item" style="margin-bottom: 18px;">
                    <label>Грамаж (г)*</label>
                    <input type="number" class="form-control-sm" @bind="inputWeight" placeholder="Напр. 150..." />
                </div>

                <button class="btn-sm btn-primary" style="width: 100%; padding: 9px;" @onclick="AddFoodEntryAsync" disabled="@isSaving">
                    @(isSaving ? "Записване..." : "💾 Добави в храненето")
                </button>
            </div>

            <div class="details-card-panel">
                <h3>🍽️ Списък с избрани храни</h3>
                <hr class="panel-divider" />

                @if (addedFoodsList.Count == 0)
                {
                    <div class="text-empty" style="padding: 40px 0;">Все още няма добавени храни към това хранене.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="foods-table">
                            <thead>
                                <tr>
                                    <th>Храна</th>
                                    <th class="text-center">Грамаж</th>
                                    <th class="text-center">Калории</th>
                                    <th class="text-center">Въглехидрати</th>
                                    <th class="text-center">Протеин</th>
                                    <th class="text-center">Мазнини</th>
                                    <th class="text-center">Действие</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in addedFoodsList)
                                {
                                    <tr>
                                        <td class="food-name">🔸 @item.FoodName</td>
                                        <td class="text-center weight-bold">@item.Weight.ToString("F0")г</td>
                                        <td class="text-center text-calories">@item.Calories.ToString("F0") kcal</td>
                                        <td class="text-center text-carbs">@item.Carbs.ToString("F1")g</td>
                                        <td class="text-center text-carbs">@item.Protein.ToString("F1")g</td>
                                        <td class="text-center text-carbs">@item.Fat.ToString("F1")g</td>
                                        <td class="text-center">
                                            <div class="admin-actions">
                                                <button class="btn-action delete" title="Изтрий" @onclick="() => DeleteFoodEntryAsync(item.Id)">🗑️</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="totals-summary-box">
                        <div class="total-metric">
                            <span class="metric-label">Общо калории:</span>
                            <span class="metric-value text-calories">@totalCaloriesSum.ToString("F0") kcal</span>
                        </div>
                        <div class="total-metric">
                            <span class="metric-label">Общо въглехидрати:</span>
                            <span class="metric-value text-carbs">@totalCarbsSum.ToString("F1")g</span>
                        </div>
                        <div class="total-metric">
                            <span class="metric-label">Общо протеин:</span>
                            <span class="metric-value">@totalProteinSum.ToString("F1")g</span>
                        </div>
                        <div class="total-metric">
                            <span class="metric-label">Общо мазнини:</span>
                            <span class="metric-value">@totalFatSum.ToString("F1")g</span>
                        </div>
                    </div>
                }
            </div>

        </div>
    }
</div>

@code {
    [Parameter] public int MealId { get; set; }

    public class FoodDropdownItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public double CaloriesPer100g { get; set; } 
        public double ProteinPer100g { get; set; }
        public double FatPer100g { get; set; }
    }

    public class AddedFoodItemVM
    {
        public int Id { get; set; }
        public int FoodId { get; set; }
        public string FoodName { get; set; } = "Зареждане...";
        public double Weight { get; set; }
        public double Calories { get; set; }
        public double Carbs { get; set; }
        public double Protein { get; set; }
        public double Fat { get; set; }
    }

    private string mealName = "Хранене";
    private DateTime mealDate = DateTime.Now;

    private List<FoodDropdownItem> allAvailableFoods = new();
    private List<AddedFoodItemVM> addedFoodsList = new();

    private int selectedFoodId = 0;
    private double? inputWeight = null;

    private bool isLoadingPage = true;
    private bool isSaving = false;
    private string pageErrorMessage = string.Empty;
    private string formErrorMessage = string.Empty;

    private double totalCaloriesSum => addedFoodsList.Sum(f => f.Calories);
    private double totalCarbsSum => addedFoodsList.Sum(f => f.Carbs);
    private double totalProteinSum => addedFoodsList.Sum(f => f.Protein);
    private double totalFatSum => addedFoodsList.Sum(f => f.Fat);

    protected override async Task OnInitializedAsync()
    {
        await LoadPageDataAsync();
    }

    private async Task LoadPageDataAsync()
    {
        isLoadingPage = true;
        pageErrorMessage = string.Empty;

        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");

            var mealRequest = new HttpRequestMessage(HttpMethod.Get, $"api/MealEntries/{MealId}");
            mealRequest.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var mealResponse = await Http.SendAsync(mealRequest);

            if (mealResponse.IsSuccessStatusCode)
            {
                var json = await mealResponse.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(json);
                var root = doc.RootElement;
                mealName = root.TryGetProperty("name", out var n) ? n.GetString() ?? "Хранене" : "Хранене";
                mealDate = root.TryGetProperty("createdAt", out var ca) && ca.TryGetDateTime(out var dt) ? dt : DateTime.Now;
            }
            else
            {
                pageErrorMessage = "Храненето не беше намерено или нямате достъп.";
                isLoadingPage = false;
                return;
            }

            var foodsRequest = new HttpRequestMessage(HttpMethod.Get, "api/Foods?PageSize=500");
            foodsRequest.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var foodsResponse = await Http.SendAsync(foodsRequest);

            if (foodsResponse.IsSuccessStatusCode)
            {
                var json = await foodsResponse.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(json);
                allAvailableFoods.Clear();

                if (doc.RootElement.TryGetProperty("items", out var itemsProp) && itemsProp.ValueKind == JsonValueKind.Array)
                {
                    foreach (var entry in itemsProp.EnumerateArray())
                    {
                        double cal100g = 0;
                        if (entry.TryGetProperty("caloriesPer100g", out var calProp))
                        {
                            cal100g = calProp.GetDouble();
                        }

                        double protein100g = 0;
                        if (entry.TryGetProperty("proteinPer100g", out var pProp))
                        {
                            protein100g = pProp.GetDouble();
                        }

                        double fat100g = 0;
                        if (entry.TryGetProperty("fatPer100g", out var fProp))
                        {
                            fat100g = fProp.GetDouble();
                        }

                        allAvailableFoods.Add(new FoodDropdownItem
                        {
                            Id = entry.TryGetProperty("id", out var id) ? id.GetInt32() : 0,
                            Name = entry.TryGetProperty("name", out var fn) ? fn.GetString() ?? "" : "",
                            CaloriesPer100g = cal100g,
                            ProteinPer100g = protein100g,
                            FatPer100g = fat100g
                        });
                    }
                }
            }

            await LoadAddedFoodEntriesAsync(token);
        }
        catch (Exception ex)
        {
            pageErrorMessage = ex.Message;
        }
        finally
        {
            isLoadingPage = false;
        }
    }

    private async Task LoadAddedFoodEntriesAsync(string token)
    {
        var entriesRequest = new HttpRequestMessage(HttpMethod.Get, $"api/FoodEntries?PageSize=100&Filters.MealEntryId={MealId}");
        entriesRequest.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
        var entriesResponse = await Http.SendAsync(entriesRequest);

        if (entriesResponse.IsSuccessStatusCode)
        {
            var json = await entriesResponse.Content.ReadAsStringAsync();
            using var doc = JsonDocument.Parse(json);
            addedFoodsList.Clear();

            if (doc.RootElement.TryGetProperty("items", out var itemsProp) && itemsProp.ValueKind == JsonValueKind.Array)
            {
                foreach (var entry in itemsProp.EnumerateArray())
                {
                    var foodId = entry.TryGetProperty("foodId", out var fId) ? fId.GetInt32() : 0;

                    double weightVal = entry.TryGetProperty("weigth", out var wProp) ? wProp.GetDouble() : 0;
                    double caloriesVal = entry.TryGetProperty("calories", out var cProp) ? cProp.GetDouble() : 0;
                    double carbsVal = entry.TryGetProperty("carbs", out var carbProp) ? carbProp.GetDouble() : 0;

                    double proteinVal = 0;
                    if (entry.TryGetProperty("protein", out var protProp))
                    {
                        proteinVal = protProp.GetDouble();
                    }

                    double fatVal = 0;
                    if (entry.TryGetProperty("fat", out var fatProp))
                    {
                        fatVal = fatProp.GetDouble();
                    }

                    var itemVM = new AddedFoodItemVM
                    {
                        Id = entry.TryGetProperty("id", out var id) ? id.GetInt32() : 0,
                        FoodId = foodId,
                        Weight = weightVal,
                        Calories = caloriesVal,
                        Carbs = carbsVal,
                        Protein = proteinVal,
                        Fat = fatVal
                    };

                    if (itemVM.Protein == 0 || itemVM.Fat == 0)
                    {
                        var foodMeta = allAvailableFoods.FirstOrDefault(f => f.Id == foodId);
                        if (foodMeta != null)
                        {
                            if (itemVM.Protein == 0)
                            {
                                itemVM.Protein = Math.Round(foodMeta.ProteinPer100g * itemVM.Weight / 100.0, 3);
                            }

                            if (itemVM.Fat == 0)
                            {
                                itemVM.Fat = Math.Round(foodMeta.FatPer100g * itemVM.Weight / 100.0, 3);
                            }
                        }
                    }

                    itemVM.FoodName = await FetchFoodNameAsync(foodId, token);
                    addedFoodsList.Add(itemVM);
                }
            }
        }
    }

    private async Task<string> FetchFoodNameAsync(int foodId, string token)
    {
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get, $"api/Foods/{foodId}");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(json);
                if (doc.RootElement.TryGetProperty("name", out var nameProp))
                {
                    return nameProp.GetString() ?? "Неизвестна храна";
                }
            }
        }
        catch { }
        return $"Храна #{foodId}";
    }

    private async Task AddFoodEntryAsync()
    {
        if (MealId <= 0 || selectedFoodId <= 0 || !inputWeight.HasValue || inputWeight.Value <= 0 || inputWeight.Value > 5000)
        {
            formErrorMessage = "Моля, попълнете коректно всички полета според изискванията.";
            return;
        }

        isSaving = true;
        formErrorMessage = string.Empty;

        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");

            var payload = new
            {
                mealEntryId = MealId,
                foodId = selectedFoodId,
                weigth = inputWeight.Value
            };

            var request = new HttpRequestMessage(HttpMethod.Post, "api/FoodEntries");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            request.Content = new StringContent(JsonSerializer.Serialize(payload), Encoding.UTF8, "application/json");

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                selectedFoodId = 0;
                inputWeight = null;
                await LoadAddedFoodEntriesAsync(token);
            }
            else
            {
                formErrorMessage = "Грешка при запис на храната в API системата.";
            }
        }
        catch (Exception ex)
        {
            formErrorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteFoodEntryAsync(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Сигурни ли сте, че искате да премахнете този продукт?");
        if (!confirmed) return;

        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            var request = new HttpRequestMessage(HttpMethod.Delete, $"api/FoodEntries/{id}");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                await LoadAddedFoodEntriesAsync(token);
            }
            else
            {
                formErrorMessage = "Възникна проблем при изтриването на продукта.";
            }
        }
        catch (Exception ex)
        {
            formErrorMessage = ex.Message;
        }
    }

    private void BackToMeals() => Navigation.NavigateTo("/meals");
}

<style>
    .meals-container {
        max-width: 1250px;
        margin: 0 auto;
        font-family: 'Segoe UI', system-ui, sans-serif;
        padding: 5px;
    }

    .page-header-inline {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
        padding-bottom: 5px;
        border-bottom: 1px solid #eef2f5;
    }

        .page-header-inline h2 {
            margin: 0;
            font-size: 20px;
            color: #2c3e50;
            font-weight: 600;
        }

    .header-divider {
        margin: 0 12px;
        color: #b2bec3;
        font-weight: 300;
    }

    .page-header-inline p {
        margin: 0;
        color: #7f8c8d;
        font-size: 13px;
    }

    .btn-add-food {
        margin-left: auto;
        color: white;
        padding: 6px 14px;
        border-radius: 6px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        font-size: 13px;
    }

    .details-split-grid {
        display: grid;
        grid-template-columns: 380px 1fr;
        gap: 15px;
        align-items: start;
    }


    .details-card-panel {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        padding: 14px;
        border-radius: 8px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.01);
    }

        .details-card-panel h3 {
            margin: 0 0 8px 0;
            font-size: 15px;
            color: #2c3e50;
            font-weight: 600;
        }

    .panel-divider {
        border: 0;
        border-top: 1px solid #f1f5f9;
        margin-bottom: 12px;
    }

    .filter-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .filter-item label {
            font-size: 11px;
            font-weight: 600;
            color: #64748b;
            text-transform: uppercase;
        }

    .form-control-sm {
        padding: 7px 10px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        font-size: 13px;
        outline: none;
        width: 100%;
        box-sizing: border-box;
        background: white;
    }

    .btn-sm {
        border: none;
        border-radius: 6px;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
        transition: background 0.15s;
    }

    .btn-primary {
        background: #3b82f6;
        color: white;
    }

        .btn-primary:hover {
            background: #2563eb;
        }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
    }

    .foods-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .foods-table th {
            background: #f8fafc;
            color: #475569;
            font-weight: 600;
            padding: 8px 12px;
            border-bottom: 1px solid #e2e8f0;
        }

        .foods-table td {
            padding: 8px 12px;
            border-bottom: 1px solid #f1f5f9;
            color: #334155;
            vertical-align: middle;
        }

    .food-name {
        font-weight: 600;
        color: #1e293b;
    }

    .text-center {
        text-align: center;
    }

    .weight-bold {
        font-weight: 600;
    }

    .text-carbs {
        color: #065f46;
        font-weight: 600;
    }

    .text-calories {
        color: #92400e;
        font-weight: 600;
    }

    .admin-actions {
        display: flex;
        justify-content: center;
    }

    .btn-action.delete {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 14px;
        padding: 2px;
    }

    .totals-summary-box {
        margin-top: 12px;
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 6px;
        padding: 10px 14px;
        display: flex;
        justify-content: flex-end;
        gap: 25px;
    }

    .total-metric {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .metric-label {
        font-size: 12.5px;
        font-weight: 600;
        color: #475569;
    }

    .metric-value {
        font-size: 14px;
        font-weight: 700;
    }

    .loading-status {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 40px;
        color: #64748b;
    }

    .spinner {
        border: 2.5px solid #f3f3f3;
        border-top: 2.5px solid #3b82f6;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        animation: spin 0.8s linear infinite;
    }



    .text-empty {
        text-align: center;
        color: #94a3b8;
        font-style: italic;
        font-size: 13px;
    }

    .alert {
        padding: 10px;
        background: #f8d7da;
        color: #721c24;
        border-radius: 6px;
        text-align: center;
        font-size: 13px;
    }
</style>